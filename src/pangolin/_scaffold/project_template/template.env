# Project identity. Change this per project — it names this project's local
# Prefect state (PREFECT_HOME below) so it doesn't collide with any other
# pangolin project on this machine.
PROJECT_NAME=pangolin

# Local Prefect state directory (server DB + profile). Without this, Prefect
# falls back to one global ~/.prefect shared by every project on this
# machine, so `prefect server start` would mix this project's deployments,
# runs and logs with every other local pangolin project's. `pangolin run` /
# `pangolin deploy` / `pangolin bootstrap` read this automatically; before
# running the bare `prefect server start` yourself, export it in that shell
# too (see Getting Started > Running via the Prefect UI).
PREFECT_HOME=.prefect/${PROJECT_NAME}

BACKEND_ENGINE=polars
FS_PROTOCOL=file
#FS_OPTIONS={"anon": true, "key": "mykey", "secret": "mysecret"} # fsspec options as a valid JSON string

BASEPATH=.
#DATAPATH=  # defaults to <BASEPATH>/data when FS_PROTOCOL=file
INPUT_FOLDER_NAME=input
STAGING_FOLDER_NAME=staging
DELIVERY_FOLDER_NAME=delivery
REPORTS_FOLDER_NAME=reports
DISABLE_REPORTS=False
BACKUP_FOLDER_NAME=backup

CSV_DELIMITER=;
OUTPUT_FORMAT=parquet

DEBUG=False
DEBUG_RUN_ID=debug_run
