# Project identity. Change this per project — it isolates this project's
# local Prefect state from every other pangolin project on this machine
# (see PREFECT_HOME below), so `prefect server start` doesn't mix this
# project's deployments/runs/logs with anyone else's.
PROJECT_NAME=pangolin

# Local Prefect state directory (server DB + profile). Defaults to
# .prefect/<PROJECT_NAME> automatically — `pangolin run` / `pangolin deploy`
# / `pangolin bootstrap` derive it from PROJECT_NAME above, nothing to set
# here. Uncomment only to override with a custom path. Before running the
# bare `prefect server start` yourself (not through pangolin), export the
# same value in that shell too — see Getting Started > Running via the
# Prefect UI.
#PREFECT_HOME=.prefect/pangolin

BACKEND_ENGINE=polars
FS_PROTOCOL=file
#FS_OPTIONS={"anon": true, "key": "mykey", "secret": "mysecret"} # fsspec options as a valid JSON string

BASEPATH=.
#DATAPATH=  # defaults to <BASEPATH>/data when FS_PROTOCOL=file
INPUT_FOLDER_NAME=input
STAGING_FOLDER_NAME=staging
DELIVERY_FOLDER_NAME=delivery
REPORTS_FOLDER_NAME=reports
DISABLE_REPORTS=False
BACKUP_FOLDER_NAME=backup

CSV_DELIMITER=;
OUTPUT_FORMAT=parquet

DEBUG=False
DEBUG_RUN_ID=debug_run
